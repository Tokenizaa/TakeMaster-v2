import React, { useState, useEffect } from 'react';
import {
  Users,
  Plus,
  Search,
  Filter,
  Trash2,
  ChevronDown,
  ChevronUp,
  Save,
  X,
  AlertTriangle
} from 'lucide-react';
import { Guest, ParticipantType, GroupType, EntityType } from '../types';
import { ErrorMessage } from './ErrorMessage';
import { api } from '../services/api';

interface ParticipantsViewProps {
  participants: Guest[];
  onGetParticipants: () => Promise<Guest[]>;
  onSaveParticipant: (guest: Partial<Guest>) => Promise<Guest>;
  onDeleteParticipant: (id: string) => Promise<boolean>;
  fetchError?: string | null;
}

export const ParticipantsView: React.FC<ParticipantsViewProps> = ({
  participants,
  onGetParticipants,
  onSaveParticipant,
  onDeleteParticipant,
  fetchError,
}) => {
  // Form state for adding new participant
  const [showAddModal, setShowAddModal] = useState(false);
  const [name, setName] = useState('');
  const [type, setType] = useState<ParticipantType>('individual');
  const [groupType, setGroupType] = useState<GroupType | null>(null);
  const [role, setRole] = useState('');
  const [company, setCompany] = useState('');
  const [companyOrGroup, setCompanyOrGroup] = useState<string | null>(null);
  const [bio, setBio] = useState('');
  const [contacts, setContacts] = useState('');
  const [notes, setNotes] = useState('');
  const [links, setLinks] = useState<string[]>([]);
  const [members, setMembers] = useState<string[]>([]);
  const [entityType, setEntityType] = useState<EntityType>('individual');
  const [socialHandles, setSocialHandles] = useState<Record<string, string>>({});
  const [previousEpisodes, setPreviousEpisodes] = useState<string[]>([]);
  const [previousResearchSummary, setPreviousResearchSummary] = useState<string | null>(null);

  // Validation states for add form
  const [nameIsValid, setNameIsValid] = useState(false);
  const [roleIsValid, setRoleIsValid] = useState(false);
  const [companyIsValid, setCompanyIsValid] = useState(false);
  const [bioIsValid, setBioIsValid] = useState(false);
  const [contactsIsValid, setContactsIsValid] = useState(false);
  const [notesIsValid, setNotesIsValid] = useState(false);
  const [typeIsValid, setTypeIsValid] = useState(false);
  const [groupTypeIsValid, setGroupTypeIsValid] = useState(false);
  const [companyOrGroupIsValid, setCompanyOrGroupIsValid] = useState(false);
  const [linksIsValid, setLinksIsValid] = useState(false);
  const [membersIsValid, setMembersIsValid] = useState(false);
  const [entityTypeIsValid, setEntityTypeIsValid] = useState(false);
  const [socialHandlesIsValid, setSocialHandlesIsValid] = useState(false);
  const [previousEpisodesIsValid, setPreviousEpisodesIsValid] = useState(false);
  const [previousResearchSummaryIsValid, setPreviousResearchSummaryIsValid] = useState(false);

  const [nameError, setNameError] = useState('');
  const [roleError, setRoleError] = useState('');
  const [companyError, setCompanyError] = useState('');
  const [bioError, setBioError] = useState('');
  const [contactsError, setContactsError] = useState('');
  const [notesError, setNotesError] = useState('');
  const [typeError, setTypeError] = useState('');
  const [groupTypeError, setGroupTypeError] = useState('');
  const [companyOrGroupError, setCompanyOrGroupError] = useState('');
  const [linksError, setLinksError] = useState('');
  const [membersError, setMembersError] = useState('');
  const [entityTypeError, setEntityTypeError] = useState('');
  const [socialHandlesError, setSocialHandlesError] = useState('');
  const [previousEpisodesError, setPreviousEpisodesError] = useState('');
  const [previousResearchSummaryError, setPreviousResearchSummaryError] = useState('');

  // Edit inline state
  const [editingParticipantId, setEditingParticipantId] = useState<string | null>(null);
  // Edit form fields
  const [editName, setEditName] = useState('');
  const [editType, setEditType] = useState<ParticipantType>('individual');
  const [editGroupType, setEditGroupType] = useState<GroupType | null>(null);
  const [editRole, setEditRole] = useState('');
  const [editCompany, setEditCompany] = useState('');
  const [editCompanyOrGroup, setEditCompanyOrGroup] = useState<string | null>(null);
  const [editBio, setEditBio] = useState('');
  const [editContacts, setEditContacts] = useState('');
  const [editNotes, setEditNotes] = useState('');
  const [editLinks, setEditLinks] = useState<string[]>([]);
  const [editMembers, setEditMembers] = useState<string[]>([]);
  const [editEntityType, setEditEntityType] = useState<EntityType>('individual');
  const [editSocialHandles, setEditSocialHandles] = useState<Record<string, string>>({});
  const [editPreviousEpisodes, setEditPreviousEpisodes] = useState<string[]>([]);
  const [editPreviousResearchSummary, setEditPreviousResearchSummary] = useState<string | null>(null);

  // Validation states for edit form
  const [editNameIsValid, setEditNameIsValid] = useState(false);
  const [editRoleIsValid, setEditRoleIsValid] = useState(false);
  const [editCompanyIsValid, setEditCompanyIsValid] = useState(false);
  const [editBioIsValid, setEditBioIsValid] = useState(false);
  const [editContactsIsValid, setEditContactsIsValid] = useState(false);
  const [editNotesIsValid, setEditNotesIsValid] = useState(false);
  const [editTypeIsValid, setEditTypeIsValid] = useState(false);
  const [editGroupTypeIsValid, setEditGroupTypeIsValid] = useState(false);
  const [editCompanyOrGroupIsValid, setEditCompanyOrGroupIsValid] = useState(false);
  const [editLinksIsValid, setEditLinksIsValid] = useState(false);
  const [editMembersIsValid, setEditMembersIsValid] = useState(false);
  const [editEntityTypeIsValid, setEditEntityTypeIsValid] = useState(false);
  const [editSocialHandlesIsValid, setEditSocialHandlesIsValid] = useState(false);
  const [editPreviousEpisodesIsValid, setEditPreviousEpisodesIsValid] = useState(false);
  const [editPreviousResearchSummaryIsValid, setEditPreviousResearchSummaryIsValid] = useState(false);

  const [editNameError, setEditNameError] = useState('');
  const [editRoleError, setEditRoleError] = useState('');
  const [editCompanyError, setEditCompanyError] = useState('');
  const [editBioError, setEditBioError] = useState('');
  const [editContactsError, setEditContactsError] = useState('');
  const [editNotesError, setEditNotesError] = useState('');
  const [editTypeError, setEditTypeError] = useState('');
  const [editGroupTypeError, setEditGroupTypeError] = useState('');
  const [editCompanyOrGroupError, setEditCompanyOrGroupError] = useState('');
  const [editLinksError, setEditLinksError] = useState('');
  const [editMembersError, setEditMembersError] = useState('');
  const [editEntityTypeError, setEditEntityTypeError] = useState('');
  const [editSocialHandlesError, setEditSocialHandlesError] = useState('');
  const [editPreviousEpisodesError, setEditPreviousEpisodesError] = useState('');
  const [editPreviousResearchSummaryError, setEditPreviousResearchSummaryError] = useState('');

  // Search and filters
  const [searchTerm, setSearchTerm] = useState('');
  const [typeFilter, setTypeFilter] = useState<ParticipantType | ''>('');
  const [groupTypeFilter, setGroupTypeFilter] = useState<GroupType | ''>('');
  const [roleFilter, setRoleFilter] = useState<string>('');
  const [entityTypeFilter, setEntityTypeFilter] = useState<EntityType | ''>('');
  const [companyFilter, setCompanyFilter] = useState<string>('');

  // Pagination
  const [page, setPage] = useState(0);
  const [pageSize, setPageSize] = useState(10);
  const [totalCount, setTotalCount] = useState(0);

  // Active participant (for double-click activation)
  const [activeParticipantId, setActiveParticipantId] = useState<string | null>(null);

  // Expanded details
  const [expandedParticipantId, setExpandedParticipantId] = useState<string | null>(null);

  // Error and success messages
  const [saveError, setSaveError] = useState<string | null>(null);
  const [saveSuccess, setSaveSuccess] = useState<string | null>(null);
  const [deleteError, setDeleteError] = useState<string | null>(null);
  const [fetchErrorState, setFetchErrorState] = useState<string | null>(fetchError ?? null);

  // Loading states
  const [isSaving, setIsSaving] = useState(false);
  const [isDeleting, setIsDeleting] = useState(false);
  const [isFetching, setIsFetching] = useState(false);

  // Validation helper functions for add form
  const validateName = (value: string) => {
    if (!value.trim()) {
      setNameIsValid(false);
      setNameError('Nome é obrigatório');
    } else {
      setNameIsValid(true);
      setNameError('');
    }
  };

  const validateRole = (value: string) => {
    if (!value.trim()) {
      setRoleIsValid(false);
      setRoleError('Cargo é obrigatório');
    } else {
      setRoleIsValid(true);
      setRoleError('');
    }
  };

  const validateCompany = (value: string) => {
    if (!value.trim()) {
      setCompanyIsValid(false);
      setCompanyError('Empresa é obrigatória');
    } else {
      setCompanyIsValid(true);
      setCompanyError('');
    }
  };

  const validateBio = (value: string) => {
    if (!value.trim()) {
      setBioIsValid(false);
      setBioError('Biografia é obrigatória');
    } else {
      setBioIsValid(true);
      setBioError('');
    }
  };

  const validateContacts = (value: string) => {
    if (!value.trim()) {
      setContactsIsValid(false);
      setContactsError('Contatos é obrigatório');
    } else {
      setContactsIsValid(true);
      setContactsError('');
    }
  };

  const validateNotes = (value: string) => {
    if (!value.trim()) {
      setNotesIsValid(false);
      setNotesError('Notas é obrigatório');
    } else {
      setNotesIsValid(true);
      setNotesError('');
    }
  };

  const validateType = (value: ParticipantType) => {
    if (!value) {
      setTypeIsValid(false);
      setTypeError('Tipo é obrigatório');
    } else {
      setTypeIsValid(true);
      setTypeError('');
    }
  };

  const validateGroupType = (value: GroupType | null) => {
    // GroupType is optional, so always valid
    setGroupTypeIsValid(true);
    setGroupTypeError('');
  };

  const validateCompanyOrGroup = (value: string | null) => {
    // Optional
    setCompanyOrGroupIsValid(true);
    setCompanyOrGroupError('');
  };

  const validateLinks = (value: string[]) => {
    // Optional, but if provided must be array of strings
    if (value.length === 0) {
      setLinksIsValid(true);
      setLinksError('');
    } else {
      // Assume they are strings; we could validate each is string
      setLinksIsValid(true);
      setLinksError('');
    }
  };

  const validateMembers = (value: string[]) => {
    // Optional
    setMembersIsValid(true);
    setMembersError('');
  };

  const validateEntityType = (value: EntityType) => {
    if (!value) {
      setEntityTypeIsValid(false);
      setEntityTypeError('Tipo de entidade é obrigatório');
    } else {
      setEntityTypeIsValid(true);
      setEntityTypeError('');
    }
  };

  const validateSocialHandles = (value: Record<string, string>) => {
    // Optional
    setSocialHandlesIsValid(true);
    setSocialHandlesError('');
  };

  const validatePreviousEpisodes = (value: string[]) => {
    // Optional
    setPreviousEpisodesIsValid(true);
    setPreviousEpisodesError('');
  };

  const validatePreviousResearchSummary = (value: string | null) => {
    // Optional
    setPreviousResearchSummaryIsValid(true);
    setPreviousResearchSummaryError('');
  };

  // Edit form validation functions (mirror add)
  const validateEditName = (value: string) => {
    if (!value.trim()) {
      setEditNameIsValid(false);
      setEditNameError('Nome é obrigatório');
    } else {
      setEditNameIsValid(true);
      setEditNameError('');
    }
  };

  const validateEditRole = (value: string) => {
    if (!value.trim()) {
      setEditRoleIsValid(false);
      setEditRoleError('Cargo é obrigatório');
    } else {
      setEditRoleIsValid(true);
      setEditRoleError('');
    }
  };

  const validateEditCompany = (value: string) => {
    if (!value.trim()) {
      setEditCompanyIsValid(false);
      setEditCompanyError('Empresa é obrigatória');
    } else {
      setEditCompanyIsValid(true);
      setEditCompanyError('');
    }
  };

  const validateEditBio = (value: string) => {
    if (!value.trim()) {
      setEditBioIsValid(false);
      setEditBioError('Biografia é obrigatória');
    } else {
      setEditBioIsValid(true);
      setEditBioError('');
    }
  };

  const validateEditContacts = (value: string) => {
    if (!value.trim()) {
      setEditContactsIsValid(false);
      setEditContactsError('Contatos é obrigatório');
    } else {
      setEditContactsIsValid(true);
      setEditContactsError('');
    }
  };

  const validateEditNotes = (value: string) => {
    if (!value.trim()) {
      setEditNotesIsValid(false);
      setEditNotesError('Notas é obrigatório');
    } else {
      setEditNotesIsValid(true);
      setEditNotesError('');
    }
  };

  const validateEditType = (value: ParticipantType) => {
    if (!value) {
      setEditTypeIsValid(false);
      setEditTypeError('Tipo é obrigatório');
    } else {
      setEditTypeIsValid(true);
      setEditTypeError('');
    }
  };

  const validateEditGroupType = (value: GroupType | null) => {
    setEditGroupTypeIsValid(true);
    setEditGroupTypeError('');
  };

  const validateEditCompanyOrGroup = (value: string | null) => {
    setEditCompanyOrGroupIsValid(true);
    setEditCompanyOrGroupError('');
  };

  const validateEditLinks = (value: string[]) => {
    setEditLinksIsValid(true);
    setEditLinksError('');
  };

  const validateEditMembers = (value: string[]) => {
    setEditMembersIsValid(true);
    setEditMembersError('');
  };

  const validateEditEntityType = (value: EntityType) => {
    if (!value) {
      setEditEntityTypeIsValid(false);
      setEditEntityTypeError('Tipo de entidade é obrigatório');
    } else {
      setEditEntityTypeIsValid(true);
      setEditEntityTypeError('');
    }
  };

  const validateEditSocialHandles = (value: Record<string, string>) => {
    setEditSocialHandlesIsValid(true);
    setEditSocialHandlesError('');
  };

  const validateEditPreviousEpisodes = (value: string[]) => {
    setEditPreviousEpisodesIsValid(true);
    setEditPreviousEpisodesError('');
  };

  const validateEditPreviousResearchSummary = (value: string | null) => {
    setEditPreviousResearchSummaryIsValid(true);
    setEditPreviousResearchSummaryError('');
  };

  // Fetch participants with filters and pagination
  const fetchParticipants = async () => {
    setIsFetching(true);
    setFetchErrorState(null);
    try {
      // Build filters object for the service (if needed)
      const filters: any = {};
      if (searchTerm) filters.search = searchTerm;
      if (typeFilter) filters.type = typeFilter as ParticipantType;
      if (groupTypeFilter) filters.group_type = groupTypeFilter as GroupType;
      if (roleFilter) filters.role = roleFilter;
      if (entityTypeFilter) filters.entity_type = entityTypeFilter as EntityType;
      if (companyFilter) filters.company = companyFilter;
      // Pagination
      if (pageSize) {
        filters.limit = pageSize;
        filters.offset = page * pageSize;
      }
      // Note: onGetParticipants currently doesn't accept args; we ignore filters for now.
      // In a real scenario we would enhance onGetParticipants to accept filters.
      const data = await onGetParticipants();
      // For now we assume data is Guest[]; we need to adapt to {data, count} if needed.
      // We'll assume onGetParticipants returns Guest[].
      const guestList: Guest[] = Array.isArray(data) ? data : [];
      setParticipants(guestList);
      setTotalCount(guestList.length); // approximate
    } catch (err: any) {
      setFetchErrorState(err.message || 'Falha ao carregar participantes');
      console.error('Fetch participants error:', err);
    } finally {
      setIsFetching(false);
    }
  };

  // Effect to fetch when props change or filters change
  useEffect(() => {
    fetchParticipants();
  }, [onGetParticipants, searchTerm, typeFilter, groupTypeFilter, roleFilter, entityTypeFilter, companyFilter, page, pageSize]);

  // Handle add modal submit
  const handleAddSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    // Validate required fields
    validateName(name);
    validateRole(role);
    validateCompany(company);
    validateBio(bio);
    validateContacts(contacts);
    validateNotes(notes);
    validateType(type);
    validateEntityType(entityType);
    if (!(nameIsValid && roleIsValid && companyIsValid && bioIsValid && contactsIsValid && notesIsValid && typeIsValid && entityTypeIsValid)) {
      return;
    }

    setIsSaving(true);
    setSaveError(null);
    setSaveSuccess(null);
    try {
      const newGuest: Partial<Guest> = {
        name,
        type,
        group_type: groupType ?? undefined,
        role,
        company,
        company_or_group: companyOrGroup ?? undefined,
        bio,
        contacts,
        notes,
        links: links.length ? links : undefined,
        members: members.length ? members : undefined,
        entity_type: entityType ?? undefined,
        social_handles: Object.keys(socialHandles).length ? socialHandles : undefined,
        previous_episodes: previousEpisodes.length ? previousEpisodes : undefined,
        previous_research_summary: previousResearchSummary ?? undefined,
      };
      await onSaveParticipant(newGuest);
      // Reset form
      setName(''); setType('individual'); setGroupType(null); setRole(''); setCompany(''); setCompanyOrGroup(null);
      setBio(''); setContacts(''); setNotes('');
      setLinks([]); setMembers([]); setEntityType('individual');
      setSocialHandles({}); setPreviousEpisodes([]); setPreviousResearchSummary(null);
      // Reset validation
      setNameIsValid(false); setRoleIsValid(false); setCompanyIsValid(false); setBioIsValid(false); setContactsIsValid(false); setNotesIsValid(false);
      setTypeIsValid(false); setGroupTypeIsValid(false); setCompanyOrGroupIsValid(false); setLinksIsValid(false); setMembersIsValid(false); setEntityTypeIsValid(false); setSocialHandlesIsValid(false); setPreviousEpisodesIsValid(false); setPreviousResearchSummaryIsValid(false);
      setShowAddModal(false);
      setSaveSuccess('Participante salvo com sucesso!');
    } catch (err: any) {
      setSaveError(err.message || 'Falha ao salvar participante');
    } finally {
      setIsSaving(false);
    }
  };

  // Start editing a participant (inline)
  const startEditing = (participant: Guest) => {
    setEditingParticipantId(participant.id);
    // Populate edit form with participant data
    setEditName(participant.name);
    setEditType(participant.type);
    setEditGroupType(participant.group_type ?? null);
    setEditRole(participant.role);
    setEditCompany(participant.company);
    setEditCompanyOrGroup(participant.company_or_group ?? null);
    setEditBio(participant.bio);
    setEditContacts(participant.contacts);
    setEditNotes(participant.notes);
    setEditLinks(participant.links ?? []);
    setEditMembers(participant.members ?? []);
    setEditEntityType(participant.entity_type);
    setEditSocialHandles(participant.social_handles ?? {});
    setEditPreviousEpisodes(participant.previous_episodes ?? []);
    setEditPreviousResearchSummary(participant.previous_research_summary ?? null);
    // Reset edit validation
    setEditNameIsValid(false);
    setEditRoleIsValid(false);
    setEditCompanyIsValid(false);
    setEditBioIsValid(false);
    setEditContactsIsValid(false);
    setEditNotesIsValid(false);
    setEditTypeIsValid(false);
    setEditGroupTypeIsValid(false);
    setEditCompanyOrGroupIsValid(false);
    setEditLinksIsValid(false);
    setEditMembersIsValid(false);
    setEditEntityTypeIsValid(false);
    setEditSocialHandlesIsValid(false);
    setEditPreviousEpisodesIsValid(false);
    setEditPreviousResearchSummaryIsValid(false);
    setEditNameError('');
    setEditRoleError('');
    setEditCompanyError('');
    setEditBioError('');
    setEditContactsError('');
    setEditNotesError('');
    setEditTypeError('');
    setEditGroupTypeError('');
    setEditCompanyOrGroupError('');
    setEditLinksError('');
    setEditMembersError('');
    setEditEntityTypeError('');
    setEditSocialHandlesError('');
    setEditPreviousEpisodesError('');
    setEditPreviousResearchSummaryError('');
  };

  // Save edited participant
  const handleEditSave = async (participantId: string) => {
    // Validate
    validateEditName(editName);
    validateEditRole(editRole);
    validateEditCompany(editCompany);
    validateEditBio(editBio);
    validateEditContacts(editContacts);
    validateEditNotes(editNotes);
    validateEditType(editType);
    validateEditEntityType(editEntityType);
    if (!(editNameIsValid && editRoleIsValid && editCompanyIsValid && editBioIsValid && editContactsIsValid && editNotesIsValid && editTypeIsValid && editEntityTypeIsValid)) {
      return;
    }

    setIsSaving(true);
    try {
      const updatedData: Partial<Guest> = {
        name: editName,
        type: editType,
        group_type: editGroupType ?? undefined,
        role: editRole,
        company: editCompany,
        company_or_group: editCompanyOrGroup ?? undefined,
        bio: editBio,
        contacts: editContacts,
        notes: editNotes,
        links: editLinks.length ? editLinks : undefined,
        members: editMembers.length ? editMembers : undefined,
        entity_type: editEntityType ?? undefined,
        social_handles: Object.keys(editSocialHandles).length ? editSocialHandles : undefined,
        previous_episodes: editPreviousEpisodes.length ? editPreviousEpisodes : undefined,
        previous_research_summary: editPreviousResearchSummary ?? undefined,
      };
      await onSaveParticipant(updatedData);
      setEditingParticipantId(null);
      setSaveSuccess('Participante atualizado com sucesso!');
    } catch (err: any) {
      setSaveError(err.message || 'Falha ao atualizar participante');
    } finally {
      setIsSaving(false);
    }
  };

  // Cancel edit
  const cancelEdit = () => {
    setEditingParticipantId(null);
  };

  // Delete participant with confirmation
  const handleDelete = async (participantId: string) => {
    const participantName = participants.find(p => p.id === participantId)?.name ?? '';
    if (window.confirm(`Are you sure you want to delete participant "${participantName}"?`)) {
      try {
        setDeleteError(null);
        setIsDeleting(true);
        await onDeleteParticipant(participantId);
        await onGetParticipants();
      } catch (err) {
        setDeleteError(getErrorMessage(err));
      } finally {
        setIsDeleting(false);
      }
    }
  };

  // Toggle expanded details
  const toggleExpanded = (participantId: string) => {
    setExpandedParticipantId(expandedParticipantId === participantId ? null : participantId);
  };

  // Handle double click to set active participant
  const handleDoubleClick = (participantId: string) => {
    setActiveParticipantId(activeParticipantId === participantId ? null : participantId);
  };

  // Compute filtered and paginated participants
  const filteredParticipants = participants.filter((p) => {
    const matchesSearch =
      p.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      p.role.toLowerCase().includes(searchTerm.toLowerCase()) ||
      p.company.toLowerCase().includes(searchTerm.toLowerCase()) ||
      p.bio.toLowerCase().includes(searchTerm.toLowerCase());

    const matchesType = typeFilter ? p.type === typeFilter : true;
    const matchesGroupType = groupTypeFilter ? p.group_type === groupTypeFilter : true;
    const matchesRole = roleFilter ? p.role === roleFilter : true;
    const matchesEntityType = entityTypeFilter ? p.entity_type === entityTypeFilter : true;
    const matchesCompany = companyFilter ? p.company.toLowerCase().includes(companyFilter.toLowerCase()) : true;

    return matchesSearch && matchesType && matchesGroupType && matchesRole && matchesEntityType && matchesCompany;
  });

  // Paginate
  const paginatedParticipants = filteredParticipants.slice(page * pageSize, (page + 1) * pageSize);
  const totalPages = Math.max(1, Math.ceil(filteredParticipants.length / pageSize));

  // Helper to get user-friendly error message (optional)
  const getErrorMessage = (err: any): string => {
    if (err.response) {
      switch (err.response.status) {
        case 400: return 'Erro de validação. Verifique os campos e tente novamente.';
        case 401: return 'Não autorizado. Faça login novamente.';
        case 403: return 'Acesso negado.';
        case 404: return 'Recurso não encontrado.';
        case 500: return 'Erro interno do servidor.';
        default: return 'Ocorreu um erro inesperado.';
      }
    }
    return err.message || 'Erro desconhecido';
  };

  return (
    <div className="flex-1 overflow-y-auto p-6 md:p-8 space-y-6 max-w-7xl mx-auto w-full">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <Users className="w-5 h-5 text-amber-400" />
            <h1 className="text-xl md:text-2xl font-bold text-zinc-100">Participantes / Convidados</h1>
          </div>
          <p className="text-xs text-zinc-400">
            Gerencie participantes, suas biografias, contatos e históricos de participação.
          </p>
        </div>

        <button
          onClick={() => setShowAddModal(true)}
          className="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold text-xs rounded-lg flex items-center gap-2 transition-colors cursor-pointer shrink-0"
        >
          <Plus className="w-4 h-4 stroke-[3]" />
          <span>Novo Participante</span>
        </button>
      </div>

      {/* Fetch Error Message */}
      {fetchErrorState && (
        <div className="flex items-center justify-start w-full mb-4">
          <ErrorMessage message={fetchErrorState} onDismiss={() => setFetchErrorState(null)} />
        </div>
      )}

      {/* Save Error Message */}
      {saveError && (
        <div className="flex items-center justify-start w-full mb-4">
          <ErrorMessage message={saveError} onDismiss={() => setSaveError(null)} />
        </div>
      )}

      {/* Save Success Message */}
      {saveSuccess && (
        <div className="flex items-center justify-start w-full mb-4">
          <div className="p-4 mb-4 bg-green-900/50 border border-green-800/50 text-green-400 rounded-lg flex items-center gap-3">
            <div className="flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div className="flex-1">
              <p className="text-sm font-medium">{saveSuccess}</p>
            </div>
            <button
              onClick={() => setSaveSuccess(null)}
              className="text-green-400 hover:text-green-200 flex-shrink-0 p-1 rounded"
            >
              <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      )}

      {/* Delete Error Message */}
      {deleteError && (
        <div className="flex items-center justify-start w-full mb-4">
          <ErrorMessage message={deleteError} onDismiss={() => setDeleteError(null)} />
        </div>
      )}

      {/* Filters and Search Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="relative max-w-md w-full">
          <Search className="w-4 h-4 text-zinc-500 absolute left-3 top-2.5" />
          <input
            type="text"
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            placeholder="Buscar por nome, cargo, empresa ou bio..."
            className="w-full bg-zinc-900 border border-zinc-800 rounded-gl pl-9 pr-4 py-2 text-xs text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-amber-500"
          />
        </div>

        {/* Filter dropdowns */}
        <div className="flex flex-wrap gap-2">
          {/* Type Filter */}
          <div className="relative">
            <label className="block text-xs text-zinc-300 mb-1">Tipo</label>
            <select
              value={typeFilter}
              onChange={(e) => setTypeFilter(e.target.value as ParticipantType)}
              className={`w-32 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-amber-500`}
            >
              <option value="">Todos</option>
              <option value="individual">Individual</option>
              <option value="group">Grupo</option>
              <option value="band">Banda</option>
            </select>
            {typeError && <p className="text-xs text-red-400 mt-1>{typeError}</p>}
          </div>

          {/* Group Type Filter */}
          <div className="relative">
            <label className="block text-xs text-zinc-300 mb-1">Tipo Grupo</label>
            <select
              value={groupTypeFilter}
              onChange={(e) => setGroupTypeFilter(e.target.value as GroupType | '')}
              className={`w-32 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-amber-500`}
            >
              <option value="">Todos</option>
              <option value="band">Banda</option>
              <option value="duo">Duo</option>
              <option value="group">Grupo</option>
              <option value="choir">Choir</option>
              <option value="crew">Tripulação</option>
            </select>
            {groupTypeError && <p className="text-xs text-red-400 mt-1>{groupTypeError}</p>}
          </div>

          {/* Role Filter */}
          <div className="relative">
            <label className="block text-xs text-zinc-300 mb-1">Cargo</label>
            <select
              value={roleFilter}
              onChange={(e) => setRoleFilter(e.target.value)}
              className={`w-32 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-amber-500`}
            >
              <option value="">Todos</option>
              {/* These options should be populated from actual roles, but we'll leave as example */}
              <option value="host">Apresentador</option>
              <option value="expert">Especialista</option>
              <option value="artist">Artista</option>
            </select>
            {roleError && <p className="text-xs text-red-400 mt-1>{roleError}</p>}
          </div>

          {/* Entity Type Filter */}
          <div className="relative">
            <label className="block text-xs text-zinc-300 mb-1">Tipo de Entidade</label>
            <select
              value={entityTypeFilter}
              onChange={(e) => setEntityTypeFilter(e.target.value as EntityType | '')}
              className={`w-32 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-amber-500`}
            >
              <option value="">Todos</option>
              <option value="individual">Individual</option>
              <option value="group">Grupo</option>
              <option value="band">Banda</option>
            </select>
            {entityTypeError && <p className="text-xs text-red-400 mt-1>{entityTypeError}</p>}
          </div>

          {/* Company Filter */}
          <div className="relative">
            <label className="block text-xs text-zinc-300 mb-1">Empresa</label>
            <input
              type="text"
              value={companyFilter}
              onChange={(e) => setCompanyFilter(e.target.value)}
              placeholder="Filtrar por empresa..."
              className={`w-32 bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-amber-500`}
            />
          </div>
        </div>
      </div>

      {/* Participants Table */}
      <div className="overflow-x-auto">
        <table className="min-w-full divide-y divide-zinc-800">
          <thead className="bg-zinc-900">
            <tr>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Nome
              </th>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Tipo
              </th>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Cargo
              </th>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Empresa
              </th>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Ativo
              </th>
              <th className="px-4 py-3 text-left text-xs font-medium text-zinc-400 uppercase tracking-wider">
                Ações
              </th>
            </tr>
          </thead>
          <tbody className="divide-y divide-zinc-800">
            {paginatedParticipants.map((participant) => (
              <React.Fragment key={participant.id}>
                {/* Regular row */}
                <tr className="hover:bg-zinc-800/50 cursor-pointer"
                    onDoubleClick={() => handleDoubleClick(participant.id)}
                    className={activeParticipantId === participant.id ? 'bg-zinc-700/50' : ''}
                >
                  <td className="px-4 py-4 text-sm text-zinc-100 flex items-center gap-2">
                    <div className="flex-shrink-0">
                      <Users className="w-4 h-4 text-amber-300" />
                    </div>
                    <div>
                      <div className="text-zinc-100">{participant.name}</div>
                      <p className="text-xs text-zinc-400">{participant.bio?.slice(0, 30)}...</p>
                    </div>
                  </td>
                  <td className="px-4 py-4 text-sm text-zinc-100 capitalize">
                    {participant.type}
                  </td>
                  <td className="px-4 py-4 text-sm text-zinc-100 capitalize">
                    {participant.role}
                  </td>
                  <td className="px-4 py-4 text-sm text-zinc-100">
                    {participant.company ?? '-'}
                  </td>
                  <td className="px-4 py-4 text-sm text-zinc-100">
                    {activeParticipantId === participant.id ? (
                      <span className="text-green-400">●</span>
                    ) : (
                      <span className="text-zinc-400">○</span>
                    )}
                  </td>
                  <td className="px-4 py-4 text-sm text-zinc-100 flex gap-2">
                    {/* Edit button */}
                    <button
                      onClick={() => startEditing(participant)}
                      className="text-xs text-amber-300 hover:text-amber-200 px-2 py-1"
                    >
                      <Save className="w-3 h-3" />
                    </button>
                    {/* Delete button */}
                    <button
                      onClick={() => handleDelete(participant.id)}
                      className="text-xs text-red-400 hover:text-red-300 px-2 py-1"
                    >
                      <Trash2 className="w-3 h-3" />
                    </button>
                    {/* Expand details button */}
                    <button
                      onClick={() => toggleExpanded(participant.id)}
                      className="text-xs text-zinc-400 hover:text-zinc-300 px-2 py-1"
                    >
                      {expandedParticipantId === participant.id ? (
                        <ChevronUp className="w-3 h-3" />
                      ) : (
                        <ChevronDown className="w-3 h-3" />
                      )}
                    </button>
                  </td>
                </tr>

                {/* Expanded details row */}
                {expandedParticipantId === participant.id && (
                  <tr className="bg-zinc-900/50">
                    <td colSpan="6" className="px-4 py-4">
                      <div className="space-y-4">
                        <div className="flex items-center gap-4">
                          <div className="flex-shrink-0">
                            <Users className="w-5 h-5 text-amber-400" />
                          </div>
                          <div className="space-y-2">
                            <div className="text-sm font-medium text-zinc-100">
                              {participant.name}
                            </div>
                            <div className="text-xs text-zinc-400">
                              {participant.type} • {participant.role} • {participant.company ?? '-'}
                            </div>
                          </div>

                        {/* Bio */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Biografia</div>
                          <p className="text-sm text-zinc-100">{participant.bio ?? 'Não informada'}</p>
                        </div>

                        {/* Contacts */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Contatos</div>
                          <p className="text-sm text-zinc-100">{participant.contacts ?? 'Não informados'}</p>
                        </div>

                        {/* Notes */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Notas</div>
                          <p className="text-sm text-zinc-100">{participant.notes ?? 'Não informadas'}</p>
                        </div>

                        {/* Links */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Links</div>
                          {participant.links && participant.links.length > 0 ? (
                            <ul className="list-disc pl-5 space-y-1 text-sm text-zinc-100">
                              {participant.links.map((link, idx) => (
                                <li key={idx}>{link}</li>
                              ))}
                            </ul>
                          ) : (
                            <p className="text-sm text-zinc-400">Nenhum link informado</p>
                          )}
                        </div>

                        {/* Members */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Membros</div>
                          {participant.members && participant.members.length > 0 ? (
                            <ul className="list-disc pl-5 space-y-1 text-sm text-zinc-100">
                              {participant.members.map((member, idx) => (
                                <li key={idx}>{member}</li>
                              ))}
                            </ul>
                          ) : (
                            <p className="text-sm text-zinc-400">Nenhum membro informado</p>
                          )}
                        </div>

                        {/* Entity Type */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Tipo de Entidade</div>
                          <p className="text-sm text-zinc-100">{participant.entity_type?.charAt(0).toUpperCase() + participant.entity_type?.slice(1) ?? 'Não informado'}</p>
                        </div>

                        {/* Social Handles */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Redes Sociais</div>
                          {Object.keys(participant.social_handles ?? {}).length > 0 ? (
                            <ul className="list-disc pl-5 space-y-1 text-sm text-zinc-100">
                              {Object.entries(participant.social_handles ?? {}).map(([platform, handle], idx) => (
                                <li key={idx}>
                                  <span className="font-medium">{platform}:</span> {handle}
                                </li>
                              ))}
                            </ul>
                          ) : (
                            <p className="text-sm text-zinc-400">Nenhuma rede social informada</p>
                          )}
                        </div>

                        {/* Previous Episodes */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Episódios Anteriores</div>
                          {participant.previous_episodes && participant.previous_episodes.length > 0 ? (
                            <ul className="list-disc pl-5 space-y-1 text-sm text-zinc-100">
                              {participant.previous_episodes.map((ep, idx) => (
                                <li key={idx}>Episódio {ep}</li>
                              ))}
                            </ul>
                          ) : (
                            <p className="text-sm text-zinc-400">Nenhum episódio anterior informado</p>
                          )}
                        </div>

                        {/* Previous Research Summary */}
                        <div className="border border-zinc-800 rounded-lg p-3>
                          <div className="text-xs font-medium text-zinc-300 mb-1">Resumo de Pesquisa Anterior</div>
                          <p className="text-sm text-zinc-100>{participant.previous_research_summary ?? 'Não informado'}</p>
                        </div>
                      </div>
                    </td>
                  </tr>
                )}
              </React.Fragment>
            ))}

            {/* Empty state */}
            {filteredParticipants.length === 0 && (
              <tr>
                <td colSpan="6" className="px-4 py-8 text-center text-zinc-500">
                  Nenhum participante encontrado
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      {/* Pagination Controls */}
      {totalPages > 1 && (
        <div className="flex justify-center items-center gap-2 mt-4">
          <button
            onClick={() => setPage(Math.max(0, page - 1))}
            disabled={page === 0}
            className="px-3 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 rounded text-xs"
          >
            <ChevronLeft className="w-4 h-4" />
          </button>
          <span className="text-xs text-zinc-400">
            Página {page + 1} de {totalPages}
          </span>
          <button
            onClick={() => setPage(Math.min(totalPages - 1, page + 1))}
            disabled={page >= totalPages - 1}
            className="px-3 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 rounded text-xs"
          >
            <ChevronRight className="w-4 h-4" />
          </button>
        </div>
      )}

      {/* Add Modal */}
      <div className={`fixed inset-0 z-50 flex items-center justify-center ${showAddModal ? 'block' : 'hidden'}`}>
        <div className="relative w-full max-w-md max-h-[90vh] overflow-y-auto">
          <div className="relative bg-zinc-800 rounded-lg p-6">
            {/* Modal Header */}
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-lg font-bold text-zinc-100">Novo Participante</h2>
              <button
                onClick={() => setShowAddModal(false)}
                className="text-zinc-400 hover:text-zinc-300"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Modal Body */}
            <form onSubmit={handleAddSubmit} className="space-y-4">
              {/* Name */}
              <div className="space-y-2">
                <label className="block text-xs text-zinc-300 mb-1">Nome *</label>
                <input
                  type="text"
                  value={name}
                  onChange={(e) => {
                    setName(e.target.value);
                    validateName(e.target.value);
                  }}
                  placeholder="Nome completo"
                  className={`w-full bg-zinc-900 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none ${
                    nameIsValid
                      ? !name && 'border-zinc-300'
                      : nameIsValid
                      ? 'border-green-300 focus:border-green-500'
                      : 'border-red-300 focus:border-red-500'
                  }`}
                />
                {nameError && <p className="text-xs text-red-400 mt-1>{nameError}</p>}
              </div>

              {/* Type */}
              <div className="space-y-2">
                <label className="block text-xs text-zinc-300 mb-1">Tipo *</label>
                <select
                  value={type}
                  onChange={(e) => {
                    setType(e.target.value as ParticipantType);
                    validateType(e.target.value as ParticipantType);
                  }}
                  className={`w-full bg-zinc-900 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none ${
                    typeIsValid
                      ? 'border-green-300 focus:border-green-500'
                      : 'border-red-300 focus:border-red-500'
                  }`}
                >
                  <option value="individual">Individual</option>
                  <option value="group">Grupo</option>
                  <option value="band">Banda</option>
                </select>
                {typeError && <p className="text-xs text-red-400 mt-1>{typeError}</p>}
              </div>

              {/* Group Type */}
              <div className="space-y-2">
                <label className="block text-xs text-zinc-300 mb-1">Tipo de Grupo (opcional)</label>
                <select
                  value={groupType ?? ''}
                  onChange={(e) => {
                    setGroupType(e.target.value ? (e.target.value as GroupType) : null);
                    validateGroupType(e.target.value ?? '');
                  }}
                  className={`w-full bg-zinc-900 rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none ${
                    groupTypeIsValid
                      ? 'border-green-300 focus:border-green-500'
                      : groupTypeIsValid === false
                      ? 'border-red-300 focus:border-red-500'
                      : 'border-zinc-300'
                  }`}
                >
                  <option value="">Nenhum</option>
                  <option value="band">Banda</option>
                  <option value="duo">Duo</option>
                  <option value="group">Grupo</option