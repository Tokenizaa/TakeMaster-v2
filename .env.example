# Supabase — existing project shared with V1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=
# Optional independent NVIDIA key used only after the primary key returns 401/403.
NIM_API_KEY_SECONDARY=
NIM_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_TIMEOUT_MS=60000

INTERNAL_SESSION_KEY=
PORT=3000

# VenoPag — PIX Cash In. Secrets stay server-side only.
VENOPAG_CLIENT_ID=
VENOPAG_CLIENT_SECRET=
VENOPAG_WEBHOOK_SECRET=
VENOPAG_BASE_URL=https://venopagments.com
# Public HTTPS endpoint configured in the VenoPag merchant dashboard:
VENOPAG_WEBHOOK_URL=
