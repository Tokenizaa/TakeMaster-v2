# Supabase — existing project shared with V1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NVIDIA NIM
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_API_KEY=
# Optional independent NVIDIA key used only after the primary key returns 401/403.
NIM_API_KEY_SECONDARY=
NIM_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_TIMEOUT_MS=60000

# Generate a random secret with at least 32 bytes of entropy; never commit the value.
# Example: openssl rand -base64 32
INTERNAL_SESSION_KEY=
PORT=3000

# Playwright E2E — configure only with a remote, approved test environment.
# Never set E2E_BASE_URL to localhost/127.0.0.1.
E2E_BASE_URL=
E2E_TARGET_KIND=staging
E2E_LOGIN_EMAIL=
E2E_LOGIN_CODE=
E2E_ORGANIZATION_ID=
# Keep false unless the configured target is an isolated test/staging environment.
E2E_ALLOW_PERSISTENT_WRITES=false
E2E_HEADLESS=true

# Password recovery email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=https://takemaster-v2.olfnetto.workers.dev
